# ==============================================================================
# SentinelGraph - CognoDB Cloud Connection Configuration
# ==============================================================================
# Sign up at https://console.cognodb.com/signup
# Create a free (c0) instance and obtain your bolt+s:// URI and password.

# CognoDB Cloud Bolt URI
COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud

# CognoDB Database User (default is "cognodb")
COGNODB_USER=cognodb

# CognoDB Database Password (generated during instance creation)
COGNODB_PASSWORD=your_generated_cognodb_password_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False
